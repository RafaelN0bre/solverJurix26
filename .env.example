# Chave da API do Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo padrão das etapas de formalização. Cada arquivo de prompt em
# prompts/formalize/ pode sobrescrever isto no front-matter (`model:`).
GEMINI_MODEL=gemini-2.5-pro

# Onde ficam os casos formalizados que a interface carrega.
# ASPIC_TRANSLATED_DIR=data/translated

# Cache em disco das respostas do LLM (chaveado por sha256 do prompt+config).
# FORMALIZE_CACHE_DIR=.cache/formalize
